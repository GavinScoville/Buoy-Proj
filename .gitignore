# ---- environment ----
.venv/
venv/
.env
__pycache__/
*.pyc

# ---- OS cruft ----
.DS_Store

# ---- data/raw: everything as downloaded (NDBC text, GRIB, bathymetry
# rasters, cartopy shapefiles). Refetchable, so never tracked. ----
data/raw/

# ---- data/processed: regenerated each run or from raw/ ----
# NOT ignored, deliberately:
#   data/processed/historic/   monthly Parquet archive, CI commits it back
#   data/processed/bathymetry/gebco_strait_subset.nc   1.5MB, needed by
#                              salish/models/ray_tracing.py at import time
data/processed/buoys/
data/processed/buoy_archive/
data/processed/predictions/
data/processed/airywaves/
*.npy
!data/processed/bathymetry/the_dump_10m.npy
!data/processed/bathymetry/fort_ebey.npy

# data/state/ is deliberately NOT ignored - it is cross-run state driving
# email dedup (alerts fire only on change) and CI commits it back.

# ---- heavy simulation output (regenerable; keep out of history) ----
# Keep artifacts/simulations/results.md, drop the per-location output dirs.
artifacts/simulations/*/
*.gif
artifacts/surface_plot.html

# ---- the report and its figures: published to GitHub Pages each run
# (python -m salish.web.export_html --site _site), never committed ----
artifacts/plots/
artifacts/site/
_site/

# ---- logs & scratch ----
cron.log
*.log
.venv.old/
*.egg-info/
